bcftools query -f '%CHROM\n' EMCAP_532_chr1-8_and_scaffold_miss90 |uniq

#remouve scaffold and keep only chr SNP
vcftools --vcf EMCAP_532_chr1-8_and_scaffold_miss90.vcf --chr 1  --chr 2 --chr 3 --chr 4 --chr 5 --chr 6 --chr 7 --chr 8  --recode --recode-INFO-all --out /gatk/data/Cece/EMCAP_533/EMCAP_532_SNPs_chr1-8_miss90.vcf

#check individuals missingness
vcftools --vcf EMCAP_532_SNPs_chr1-8_miss90.vcf.recode.vcf --missing-indv --out missing_chickpea_all_1kindsnps_FINAL_filtered


#Trasform the thinned vcf in file.bed
/home/plink-ng/1.9/plink --vcf /gatk/data/Cece/EMCAP_533/EMCAP_532_SNPs_chr1-8_miss90_thinned.vcf.recode.vcf --allow-extra-chr --double-id --make-bed --recode A --out /gatk/data/Cece/EMCAP_533/EMCAP_532_SNPs_chr1-8_miss90_thinned_readyADM

#Admixture
for K in 1 2 3 4 5 6 7 8;
  do ./admixture --cv=10 /gatk/data/Cece/EMCAP_533/EMCAP_532_SNPs_chr1-8_miss90_thinned_readyADM.bed $K | tee log${K}.out; done


#trasnform file in hmp for PCA analysis with Tassel5

/home/tassel-5-standalone/run_pipeline.pl -Xmx20g -fork1 -vcf /gatk/data/Cece/EMCAP_533/EMCAP_532_SNPs_chr1-8_miss90_thinned.vcf.recode.vcf -export /gatk/data/Cece/EMCAP_533/EMCAP_532_SNPs_chr1-8_miss90_thinned.vcf.recode.hmp -r unfork1
